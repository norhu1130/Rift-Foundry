{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lol-build.example/schemas/patch-lock.schema.json",
  "title": "LoL Build Engine Patch Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "region",
    "game_patch",
    "locale",
    "created_at",
    "upstreams",
    "files"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "region": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "game_patch": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}_[A-Z]{2}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "upstreams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_dragon", "community_dragon"],
      "properties": {
        "data_dragon": { "$ref": "#/$defs/dataDragon" },
        "community_dragon": { "$ref": "#/$defs/communityDragon" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lockedFile" }
    }
  },
  "$defs": {
    "dataDragon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "realm_version", "latest_observed_version", "realm_url", "versions_url"],
      "properties": {
        "build": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "realm_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "latest_observed_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "realm_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "versions_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "communityDragon": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "NOT_LOCKED" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "revision", "base_url"],
          "properties": {
            "status": { "const": "LOCKED" },
            "revision": { "type": "string", "minLength": 1 },
            "base_url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      ]
    },
    "lockedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "role", "url", "path", "sha256", "retrieved_at"],
      "properties": {
        "source": { "enum": ["DATA_DRAGON", "COMMUNITY_DRAGON"] },
        "role": {
          "enum": ["VERSIONS", "REALM", "ITEMS", "CHAMPIONS", "RUNES", "SPELLS", "OTHER"]
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "locale": { "type": ["string", "null"], "pattern": "^[a-z]{2}_[A-Z]{2}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
